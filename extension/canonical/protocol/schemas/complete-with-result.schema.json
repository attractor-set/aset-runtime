{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_work_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_bindings": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "result_binding": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "terminal_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "work_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "work_id",
    "accepted_work_digest",
    "terminal_record_digest",
    "result_binding",
    "evidence_bindings"
  ],
  "type": "object"
}

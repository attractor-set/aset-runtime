{
  "$id": "https://aset.example/schemas/worker/accept-work.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_work_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "context_binding": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_constraints_binding": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "input_bindings": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "predecessor_terminal_binding": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "work_id": {
      "minLength": 1,
      "type": "string"
    },
    "work_spec_binding": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "worker_binding": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "work_id",
    "accepted_work_digest",
    "worker_binding",
    "context_binding",
    "work_spec_binding",
    "input_bindings",
    "execution_constraints_binding"
  ],
  "type": "object"
}

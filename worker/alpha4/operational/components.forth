: START-MISSING          ( state request -- state result )  EXACT-START? 0= KEEP-WORK WORK-BINDING-REQUIRED ;
: START-FRESH            ( state request -- state result )  EXACT-START? FRESH-WORK-ID? ADD-START WORK-STARTED ;
: START-REPLAY           ( state request -- state result )  EXACT-START? EXACT-START-REPLAY? KEEP-WORK IDEMPOTENT-REPLAY ;
: START-CONFLICT         ( state request -- state result )  EXACT-START? CONFLICTING-WORK-ID? KEEP-WORK WORK-IDENTITY-CONFLICT ;
: END-NOT-STARTED        ( state request -- state result )  WORK-STARTED? 0= KEEP-WORK WORK-NOT-STARTED ;
: END-BINDING-MISMATCH   ( state request -- state result )  WORK-STARTED? START-BINDING-MATCH? 0= KEEP-WORK WORK-BINDING-MISMATCH ;
: END-KIND-REQUIRED      ( state request -- state result )  WORK-STARTED? START-BINDING-MATCH? TERMINAL-KIND? 0= KEEP-WORK TERMINAL-KIND-REQUIRED ;
: END-BINDING-REQUIRED   ( state request -- state result )  WORK-STARTED? START-BINDING-MATCH? TERMINAL-KIND? EXACT-TERMINAL? 0= KEEP-WORK TERMINAL-BINDING-REQUIRED ;
: END-RESULT             ( state request -- state result )  EXACT-END? RUNNING-WORK? RESULT? ADD-TERMINAL WORK-ENDED-WITH-RESULT ;
: END-NO-RESULT          ( state request -- state result )  EXACT-END? RUNNING-WORK? NO-RESULT? ADD-TERMINAL WORK-ENDED-WITH-NO-RESULT ;
: END-REPLAY             ( state request -- state result )  EXACT-END? EXACT-TERMINAL-REPLAY? KEEP-WORK IDEMPOTENT-REPLAY ;
: END-CONFLICT           ( state request -- state result )  EXACT-END? TERMINAL-EXISTS? CONFLICTING-TERMINAL? KEEP-WORK TERMINAL-WORK-IMMUTABLE ;
